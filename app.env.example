# ============================================================
#  mit-app-api 环境变量示例
#  复制成 app.env 并改成你自己的值（app.env 已在 .gitignore，不会被提交）
#  用法：docker compose --env-file app.env -f docker-compose.full.yml up -d
# ============================================================

# ---- MySQL / Redis 账号密码（改成你自己的）----
MIT_DB_ROOT_PASSWORD=CHANGE_ME_ROOT_PWD
MIT_DB_USER=mit
MIT_DB_PASSWORD=CHANGE_ME_DB_PWD
MIT_DB_NAME=mit
MIT_REDIS_PASSWORD=CHANGE_ME_REDIS_PWD

# ---- 访问令牌（App「设置 → API Key」填同一个值；留空 = 不校验）----
# 生成随机串（PowerShell）：
#   [guid]::NewGuid().ToString("N") + [guid]::NewGuid().ToString("N")
MIT_API_TOKEN=

# ---- 默认翻译器 / 目标语言 ----
MIT_TRANSLATOR=deepseek
MIT_TARGET_LANG=CHS
MIT_CONTEXT_PAGES=3

# ---- L1 结果缓存 TTL（秒）；0 = 永不过期 ----
# MIT_CACHE_TTL=1209600

# ---- 宿主端口（避开你已有的服务端口）----
MIT_APP_PORT=8020
MIT_DB_HOST_PORT=33063
MIT_REDIS_HOST_PORT=56379
MIT_WEB_PORT=8010

# ---- 运行期数据根目录（模型 / MySQL / Redis / 缓存 / 书页）----
# 默认 ./_runtime（项目内）；想搬走就设成绝对路径，例如 MIT_RUNTIME=D:/mit
# MIT_RUNTIME=./_runtime

# ---- 引擎密钥文件（其他翻译服务 Key 等）；默认 ./secret.env ----
# MIT_SECRET_ENV=./secret.env

# ---- 引擎基镜像（国内用 DaoCloud 镜像，可改回官方）----
# MIT_BASE_IMAGE=docker.m.daocloud.io/pytorch/pytorch:2.8.0-cuda12.8-cudnn9-runtime

# ---- HuggingFace 镜像 / 容器出网代理（国内网络）----
# MIT_HF_ENDPOINT=https://hf-mirror.com
# MIT_PROXY_URL=http://host.docker.internal:7897   # 不需要代理就设成空串

# ---- 引擎地址（同 compose 网络内按服务名访问，默认不动）----
# MIT_ENGINE_URL=http://engine:8000

# ---- 译文图 WebP 无损压缩（省流量、不降质）；0 = 关 ----
# MIT_IMAGE_COMPRESS=1

# ---- 内网穿透 frp（可选，详见 docker/tunnel/README.md）----
# frp token 写在 docker/tunnel/frpc.toml（已 gitignore）；这里只覆盖镜像
# MIT_FRPC_IMAGE=docker.m.daocloud.io/snowdreamtech/frpc:latest
